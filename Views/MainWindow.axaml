<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:models="using:smartFactoryApp.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1110" d:DesignHeight="600"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1110"
        Height="600"
        Title="smartFactoryApp" >


    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
     <!-- Links oben ausrichten: das Fenster ist breiter als das Bild (900 x 600) -->
     <Image Source="avares://smartFactoryApp/Assets/factory_plan.png"
           Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="1110" >

        <!-- Bedienfeld 1: Bestellung, Logistik-Plan, Produktion -->
        <StackPanel Canvas.Left="610" Canvas.Top="20" Width="245" Spacing="4">
            <TextBlock Text="Order" FontSize="18" FontWeight="Bold" Foreground="Black"/>
            <!-- Je Farbe: bestellt (Order) und ausgeliefert (Delivered) -->
            <Grid ColumnDefinitions="80,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Order"     FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Delivered" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" Grid.Column="0" Background="Gold"        Margin="2"><TextBlock Text="yellow" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                <Border Grid.Row="2" Grid.Column="0" Background="RoyalBlue"   Margin="2"><TextBlock Text="blue"   FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/></Border>
                <Border Grid.Row="3" Grid.Column="0" Background="Firebrick"   Margin="2"><TextBlock Text="red"    FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/></Border>
                <Border Grid.Row="4" Grid.Column="0" Background="ForestGreen" Margin="2"><TextBlock Text="green"  FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/></Border>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding YellowOrder}" FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlueOrder}"   FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RedOrder}"    FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GreenOrder}"  FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding YellowDelivered}" FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BlueDelivered}"   FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RedDelivered}"    FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding GreenDelivered}"  FontSize="15" Foreground="Black" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="OrderInfoText" Text="{Binding OrderInfo}" TextWrapping="Wrap" FontSize="13" FontWeight="Bold" Foreground="DarkBlue"/>

            <TextBlock Text="Logistics plan" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
            <TextBlock x:Name="LogisticsPlanText" Text="{Binding LogisticsPlan}" TextWrapping="Wrap" FontSize="13" Foreground="DarkGreen" MinHeight="54"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                <Button x:Name="SetupProductionLinesButton" Grid.Row="0" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13"
                        Click="SetupProductionLines_Click">
                    <TextBlock Text="Setup Production Lines" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button x:Name="OrderButton"      Grid.Row="0" Grid.Column="1" Content="Order"        Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Click="Order_Click"/>
                <Button x:Name="GoToPickUpButton" Grid.Row="1" Grid.Column="0" Content="GoToPickUp"   Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Click="GoToPickUp_Click"/>
                <Button x:Name="GoToDeliveryButton" Grid.Row="1" Grid.Column="1" Content="GoToDelivery" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Click="GoToDelivery_Click"/>
            </Grid>

            <TextBlock Text="Förderbänder" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="StartTimerButton" Grid.Column="0" Content="Start" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Click="StartTimer_Click"/>
                <Button x:Name="StopTimerButton"  Grid.Column="1" Content="Stop"  Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="14" Click="StopTimer_Click"/>
            </Grid>
        </StackPanel>

        <!-- Bedienfeld 2: Roboter -->
        <StackPanel Canvas.Left="870" Canvas.Top="20" Width="220" Spacing="6">
            <TextBlock Text="Roboter" FontSize="18" FontWeight="Bold" Foreground="Black"/>

            <!-- Bewegungsmodus: Step = ein Klick, ein Schritt; Move = kontinuierlich (nur nach START).
                 Der aktive Modus wird über die Klasse "aktiv" hervorgehoben. -->
            <Grid ColumnDefinitions="*,*">
                <Grid.Styles>
                    <Style Selector="Button.aktiv">
                        <Setter Property="Background" Value="LightGreen"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </Grid.Styles>
                <Button x:Name="StepModeButton" Grid.Column="0" Content="Step" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16"
                        Classes.aktiv="{Binding IsStepMode}" Click="StepMode_Click"/>
                <Button x:Name="MoveModeButton" Grid.Column="1" Content="Move" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16"
                        Classes.aktiv="{Binding IsMoveMode}" Click="MoveMode_Click"/>
            </Grid>

            <!-- Steuerkreuz: 8 Richtungen, Stop in der Mitte -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
                <Button x:Name="UpLeftButton"    Grid.Row="0" Grid.Column="0" Content="↖" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveUpLeft_Click"/>
                <Button x:Name="UpButton"        Grid.Row="0" Grid.Column="1" Content="Up" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveUp_Click"/>
                <Button x:Name="UpRightButton"   Grid.Row="0" Grid.Column="2" Content="↗" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveUpRight_Click"/>
                <Button x:Name="LeftButton"      Grid.Row="1" Grid.Column="0" Content="Left" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveLeft_Click"/>
                <Button x:Name="StopButton"      Grid.Row="1" Grid.Column="1" Content="Stop" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="Stop_Click"/>
                <Button x:Name="RightButton"     Grid.Row="1" Grid.Column="2" Content="Right" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveRight_Click"/>
                <Button x:Name="DownLeftButton"  Grid.Row="2" Grid.Column="0" Content="↙" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveDownLeft_Click"/>
                <Button x:Name="DownButton"      Grid.Row="2" Grid.Column="1" Content="Down" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveDown_Click"/>
                <Button x:Name="DownRightButton" Grid.Row="2" Grid.Column="2" Content="↘" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveDownRight_Click"/>
            </Grid>

            <!-- Drehen -->
            <Grid ColumnDefinitions="*,*,*">
                <Button x:Name="RotateLeftButton"    Grid.Column="0" Content="⟲" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveRotateLeft_Click"/>
                <Button x:Name="ResetRotationButton" Grid.Column="1" Content="Reset" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="ResetRotation_Click"/>
                <Button x:Name="RotateRightButton"   Grid.Column="2" Content="⟳" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="MoveRotateRight_Click"/>
            </Grid>

            <!-- Abdocken: angedockt wird automatisch, sobald der Greifpunkt nah genug an einem Brick ist -->
            <Button x:Name="UndockButton" Content="Undock" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Click="UndockButton_Click"/>
            <!-- Rückmeldung zu Undock, GoToPickUp und GoToDelivery -->
            <TextBlock x:Name="UndockInfoText" Text="{Binding UndockInfo}" TextWrapping="Wrap" FontSize="13" Foreground="DarkRed" MinHeight="36"/>
        </StackPanel>

        <!-- Bilder Oben (oben mittig) und Unten (Mitte der Fläche); Position/Größe aus ViewParameters,
             dort sind sie auch als Hindernisse für den Roboter hinterlegt. -->
        <Image Source="avares://smartFactoryApp/Assets/Oben.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.ObenWidth}" Height="{x:Static models:ViewParameters.ObenHeight}"
               Canvas.Left="{x:Static models:ViewParameters.ObenX}" Canvas.Top="{x:Static models:ViewParameters.ObenY}"/>
        <Image Source="avares://smartFactoryApp/Assets/Unten.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.UntenWidth}" Height="{x:Static models:ViewParameters.UntenHeight}"
               Canvas.Left="{x:Static models:ViewParameters.UntenX}" Canvas.Top="{x:Static models:ViewParameters.UntenY}"/>

        <!-- Pfeile neben der Delivery-Linie: defekte Bricks fahren nach links ins Recycling, gute nach rechts zum Kunden.
             Größe 126x28 wie ToRecycleLine/ToCustomerLine in ViewParameters. -->
        <Canvas Canvas.Left="{x:Static models:ViewParameters.ToRecycleLineX}" Canvas.Top="{x:Static models:ViewParameters.ToRecycleLineY}">
            <Polygon Points="0,14 22,0 22,4 126,4 126,24 22,24 22,28" Fill="#F4A6A6" Stroke="Black"/>
            <TextBlock Canvas.Left="30" Canvas.Top="6" Text="For Recycling" FontSize="12" FontWeight="Bold" Foreground="Black"/>
        </Canvas>
        <Canvas Canvas.Left="{x:Static models:ViewParameters.ToCustomerLineX}" Canvas.Top="{x:Static models:ViewParameters.ToCustomerLineY}">
            <Polygon Points="0,4 104,4 104,0 126,14 104,28 104,24 0,24" Fill="#B5E61D" Stroke="Black"/>
            <TextBlock Canvas.Left="8" Canvas.Top="6" Text="To Customers" FontSize="12" FontWeight="Bold" Foreground="Black"/>
        </Canvas>

        <!-- Förderbänder: stehen vor den Bricks im XAML, damit sie darunter gezeichnet werden.
             Canvas.Left/Top = Linienstart (x, y) = linke obere Ecke von Brick 0.
             Das Bild (160x28) wird um seinen Mittelpunkt gedreht (RenderTransformOrigin 50%,50%).
             Margin schiebt den Bildmittelpunkt auf die Mitte des Bereichs, den die Bricks inkl. Fahrweg (10 * 3 px = 30 px) belegen,
             quer dazu 7 px nach außen, damit die Bricks am inneren Bandrand liegen (greifbar, wie das Hindernis in Beweger).
             Margin = Mitte - (Breite/2, Höhe/2) = Mitte - (80, 14):
             - Waagerecht (Gelb/Grün, Winkel 0): Bricks bei x + i*20, laufen zuerst 30 px nach links
               → Brick-Mitten (Brick 18x14) x-21 .. x+69, Mitte (x+24, y+7+7) → Margin = (24-80, 14-14) = (-56, 0).
             - Senkrecht (Rot/Blau, Winkel 90): Bricks bei y + i*20, um 90° gedreht, laufen zuerst 30 px nach oben
               → Brick-Mitten y-23 .. y+67; Rot Mitte (x+9-7, y+22) → Margin = (2-80, 22-14) = (-78, 8),
                 Blau Mitte (x+9+7, y+22) → Margin = (16-80, 22-14) = (-64, 8). -->
        <Image Source="avares://smartFactoryApp/Assets/Foerderband.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.ProductionLineWidth}" Height="{x:Static models:ViewParameters.ProductionLineHeight}"
               Margin="-56,0,0,0" RenderTransformOrigin="50%,50%"
               Canvas.Left="{Binding ProductionYellowX}" Canvas.Top="{Binding ProductionYellowY}">
               <Image.RenderTransform><RotateTransform Angle="{Binding ProductionYellowAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/Foerderband.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.ProductionLineWidth}" Height="{x:Static models:ViewParameters.ProductionLineHeight}"
               Margin="-78,8,0,0" RenderTransformOrigin="50%,50%"
               Canvas.Left="{Binding ProductionRedX}" Canvas.Top="{Binding ProductionRedY}">
               <Image.RenderTransform><RotateTransform Angle="{Binding ProductionRedAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/Foerderband.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.ProductionLineWidth}" Height="{x:Static models:ViewParameters.ProductionLineHeight}"
               Margin="-64,8,0,0" RenderTransformOrigin="50%,50%"
               Canvas.Left="{Binding ProductionBlueX}" Canvas.Top="{Binding ProductionBlueY}">
               <Image.RenderTransform><RotateTransform Angle="{Binding ProductionBlueAngle}"/></Image.RenderTransform>
        </Image>
        <Image Source="avares://smartFactoryApp/Assets/Foerderband.png" Stretch="Fill"
               Width="{x:Static models:ViewParameters.ProductionLineWidth}" Height="{x:Static models:ViewParameters.ProductionLineHeight}"
               Margin="-56,0,0,0" RenderTransformOrigin="50%,50%"
               Canvas.Left="{Binding ProductionGreenX}" Canvas.Top="{Binding ProductionGreenY}">
               <Image.RenderTransform><RotateTransform Angle="{Binding ProductionGreenAngle}"/></Image.RenderTransform>
        </Image>

        <!-- Namen der Linien (die Bricks darauf haben zufällige Farben, die Linie behält ihren Namen) -->
        <TextBlock Canvas.Left="110" Canvas.Top="482" Text="Yellow Line" FontSize="12" FontWeight="Bold" Foreground="DarkGoldenrod"/>
        <TextBlock Canvas.Left="340" Canvas.Top="482" Text="Green Line"  FontSize="12" FontWeight="Bold" Foreground="ForestGreen"/>
        <TextBlock Canvas.Left="102" Canvas.Top="286" Text="Red Line"    FontSize="12" FontWeight="Bold" Foreground="Firebrick"/>
        <TextBlock Canvas.Left="465" Canvas.Top="306" Text="Blue Line"   FontSize="12" FontWeight="Bold" Foreground="RoyalBlue"/>

        <!-- Bricks: erst nach "Setup Production Lines" sichtbar; Farbe zufällig (aus dem LegoBrickViewModel) -->
        <!-- Bricks der gelben Linie -->
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding YellowBricks[0].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding YellowBricks[0].X}" Canvas.Top="{Binding YellowBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding YellowBricks[1].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding YellowBricks[1].X}" Canvas.Top="{Binding YellowBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding YellowBricks[2].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding YellowBricks[2].X}" Canvas.Top="{Binding YellowBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding YellowBricks[3].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding YellowBricks[3].X}" Canvas.Top="{Binding YellowBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding YellowBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>

        <!-- Bricks der roten Linie -->
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding RedBricks[0].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding RedBricks[0].X}" Canvas.Top="{Binding RedBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding RedBricks[1].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding RedBricks[1].X}" Canvas.Top="{Binding RedBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding RedBricks[2].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding RedBricks[2].X}" Canvas.Top="{Binding RedBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding RedBricks[3].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding RedBricks[3].X}" Canvas.Top="{Binding RedBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RedBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>

        <!-- Bricks der blauen Linie -->
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding BlueBricks[0].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding BlueBricks[0].X}" Canvas.Top="{Binding BlueBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding BlueBricks[1].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding BlueBricks[1].X}" Canvas.Top="{Binding BlueBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding BlueBricks[2].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding BlueBricks[2].X}" Canvas.Top="{Binding BlueBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding BlueBricks[3].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding BlueBricks[3].X}" Canvas.Top="{Binding BlueBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding BlueBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>

        <!-- Bricks der grünen Linie -->
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding GreenBricks[0].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding GreenBricks[0].X}" Canvas.Top="{Binding GreenBricks[0].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[0].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding GreenBricks[1].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding GreenBricks[1].X}" Canvas.Top="{Binding GreenBricks[1].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[1].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding GreenBricks[2].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding GreenBricks[2].X}" Canvas.Top="{Binding GreenBricks[2].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[2].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="18" Height="14" Stroke="Black" Fill="{Binding GreenBricks[3].Fill}" IsVisible="{Binding BricksVisible}"
                   Canvas.Left="{Binding GreenBricks[3].X}" Canvas.Top="{Binding GreenBricks[3].Y}">
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding GreenBricks[3].Angle}"/></Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle x:Name="RobotRectangle" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}" Width="70" Height="50" Stroke="Black" >
            <Rectangle.RenderTransform><RotateTransform Angle="{Binding RobotAngle}"/></Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://smartFactoryApp/Assets/robot.png"/>
            </Rectangle.Fill>
        </Rectangle>

        <TextBox x:Name="PositionTextBoxX" Canvas.Left="100" Canvas.Top="100" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotX}" />
        <TextBox x:Name="PositionTextBoxY" Canvas.Left="100" Canvas.Top="150" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotY}" />
    </Canvas>

</Grid>

</Window>
